{
  "name": "ai-fitness-coach",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace apps/web run dev -- --host 0.0.0.0",
    "dev:api": ". .venv/bin/activate 2>/dev/null || true; cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:bot": ". .venv/bin/activate 2>/dev/null || true; cd apps/api && python -m app.bot.polling",
    "dev:all": "npm-run-all --parallel dev:web dev:api dev:bot",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run preview -- --host 0.0.0.0 --port ${PORT:-5173}",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/web run typecheck && sh -c '. .venv/bin/activate 2>/dev/null || true; cd apps/api && pytest'",
    "install:api": "python3 -m venv .venv && . .venv/bin/activate && pip install -r apps/api/requirements.txt"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
